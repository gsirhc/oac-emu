+// SEEK to a logical track, double stepping 48 tpi media in a 96 tpi drive.
   bx_bool
+floppy_seek(drive, track)
+  Bit16u drive;
+  Bit8u  track;
+{
+  Bit8u  val8, cyl;
+  Bit16u curr_cyl_offset;
+
+  //
+  // DS has been set to 0x40 before call
+  //
+
+  curr_cyl_offset = drive ? 0x0095 : 0x0094;
+  cyl = track;
+  if (read_byte_DS(drive ? 0x0091 : 0x0090) & 0x20)
+    cyl <<= 1;
+  if (read_byte_DS(curr_cyl_offset) == cyl)
+    return(1);
+
+  floppy_prepare_controller(drive);
+  outb(PORT_FD_DATA, 0x0f);  // 0f: Seek
+  outb(PORT_FD_DATA, drive);
+  outb(PORT_FD_DATA, cyl);
+
+ASM_START
+  sti
+ASM_END
+  do {
+    if (read_byte_DS(0x0040) == 0) {
+      floppy_reset_controller();
+      return(0);
+    }
+    val8 = (read_byte_DS(0x003e) & 0x80);
+  } while ( val8 == 0 );
+
+  val8 = 0; // separate asm from while() loop
+ASM_START
+  cli
+ASM_END
+
+  val8 = read_byte_DS(0x003e);
+  write_byte_DS(0x003e, val8 & 0x7f);
+  write_byte_DS(curr_cyl_offset, cyl);
+  return(1);
+}
+
+// READ ID on head 0 at the selected data rate: 1 found an ID, 0 none, 2 timed out.
+  Bit16u
+floppy_read_id(drive)
+  Bit16u drive;
+{
+  Bit8u  val8, st0;
+
+  //
+  // DS has been set to 0x40 before call
+  //
+
+  floppy_prepare_controller(drive);
+  outb(PORT_FD_DATA, 0x4a);  // 4a: Read ID, MFM
+  outb(PORT_FD_DATA, drive);
+
+ASM_START
+  sti
+ASM_END
+  do {
+    if (read_byte_DS(0x0040) == 0) {
+      floppy_reset_controller();
+      return(2);
+    }
+    val8 = (read_byte_DS(0x003e) & 0x80);
+  } while ( val8 == 0 );
+
+  val8 = 0; // separate asm from while() loop
+ASM_START
+  cli
+ASM_END
+
+  val8 = read_byte_DS(0x003e);
+  write_byte_DS(0x003e, val8 & 0x7f);
+  st0 = inb(PORT_FD_DATA);
+  val8 = inb(PORT_FD_DATA);
+  val8 = inb(PORT_FD_DATA);
+  val8 = inb(PORT_FD_DATA);
+  val8 = inb(PORT_FD_DATA);
+  val8 = inb(PORT_FD_DATA);
+  val8 = inb(PORT_FD_DATA);
+  return((st0 & 0xc0) == 0);
+}
