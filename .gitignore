*.net

# local emscripten / Playwright caches (never commit)
.emcache/
.playwright-browsers/

# ad-hoc local test runners (see agent/debug sessions)
tmp-run-*.sh

# deployed-site staging (built by CI, previewed locally)
_site/
_site.new/
_down/
# local TLS cert for `make preview` (see Makefile's preview-cert)
.preview-tls/
.tools/
